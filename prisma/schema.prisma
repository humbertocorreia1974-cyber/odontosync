generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  termsAcceptedAt          DateTime?
  id                       String              @id @default(cuid())
  name                     String?
  email                    String              @unique
  passwordHash             String
  plan                     String              @default("free")
  // 🩹 2026-09-01: apps com múltiplos papéis (jogador/dono, recepção/vet/admin…)
  // faziam `prisma.user.findMany({ where: { role } })` e o build quebrava
  // (TS2353: 'role' não existe em UserWhereInput). Agora a fundação tem o campo.
  role                     String              @default("user")
  stripeCustomerId         String?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  projects                 Project[]
  appointment_createdBys   Appointment[]       @relation("AppointmentCreatedBy")
  appointment_dentistUsers Appointment[]       @relation("AppointmentDentistUser")
  patient                  Patient?
  dentist                  Dentist?
  insuranceGuides          InsuranceGuide[]
  treatmentPlans           TreatmentPlan[]     @relation("TreatmentPlanCreatedBy")
  clinicalEvolutions       ClinicalEvolution[]
  attachments              Attachment[]
  inventoryMovements       InventoryMovement[]
  commissions              Commission[]        @relation("CommissionDentistUser")
  transactions             Transaction[]
  notifications            Notification[]
  auditLogs                AuditLog[]
  subscriptions            Subscription[]
  patientId                String?
  dentistId                String?
  Clinic                   Clinic?             @relation(fields: [clinicId], references: [id])
  clinicId                 String?
  Unit                     Unit?               @relation(fields: [unitId], references: [id])
  unitId                   String?
}

model Project {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([ownerId])
}

model Clinic {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  cnpj         String?  @unique
  email        String?
  phone        String?
  logoUrl      String?
  primaryColor String   @default("#1E5FBF")
  accentColor  String   @default("#3DD9B0")
  timezone     String   @default("America/Sao_Paulo")
  locale       String   @default("pt-BR")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  units              Unit[]
  users              User[]
  patients           Patient[]
  dentists           Dentist[]
  procedures         Procedure[]
  insurances         Insurance[]
  treatmentPlans     TreatmentPlan[]
  appointments       Appointment[]
  inventoryItems     InventoryItem[]
  transactions       Transaction[]
  commissions        Commission[]
  auditLogs          AuditLog[]
  notifications      Notification[]
  subscriptions      Subscription[]
  insuranceGuides    InsuranceGuide[]
  clinicalEvolutions ClinicalEvolution[]
  attachments        Attachment[]
  inventoryMovements InventoryMovement[]
  addresss           Address[]
  shipments          Shipment[]

  @@index([slug])
}

model Unit {
  id          String   @id @default(cuid())
  clinicId    String
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name        String
  code        String?
  addressLine String?
  city        String?
  state       String?
  zipCode     String?
  country     String   @default("BR")
  phone       String?
  email       String?
  latitude    Float?
  longitude   Float?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users              User[]
  chairs             Chair[]
  patients           Patient[]
  dentists           Dentist[]
  appointments       Appointment[]
  inventoryItems     InventoryItem[]
  inventoryMovements InventoryMovement[]
  transactions       Transaction[]
  commissions        Commission[]
  insuranceGuides    InsuranceGuide[]
  treatmentPlans     TreatmentPlan[]
  shipment_fromUnits Shipment[]          @relation("ShipmentFromUnit")
  shipment_toUnits   Shipment[]          @relation("ShipmentToUnit")
  addresss           Address[]

  @@unique([clinicId, name])
  @@index([clinicId])
}

model Patient {
  id       String  @id @default(cuid())
  clinicId String
  clinic   Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  unitId   String?
  unit     Unit?   @relation(fields: [unitId], references: [id])
  userId   String? @unique
  user     User?   @relation(fields: [userId], references: [id])

  fullName    String
  cpf         String?
  birthDate   DateTime?
  gender      String?
  email       String?
  phone       String?
  whatsapp    String?
  addressLine String?
  city        String?
  state       String?
  zipCode     String?
  notes       String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  appointments       Appointment[]
  treatmentPlans     TreatmentPlan[]
  toothRecords       ToothRecord[]
  clinicalEvolutions ClinicalEvolution[]
  attachments        Attachment[]
  insuranceGuides    InsuranceGuide[]
  transactions       Transaction[]
  notifications      Notification[]
  addresss           Address[]
  shipments          Shipment[]

  @@index([clinicId])
  @@index([unitId])
  @@index([cpf])
}

model Dentist {
  id       String  @id @default(cuid())
  clinicId String
  clinic   Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  unitId   String?
  unit     Unit?   @relation(fields: [unitId], references: [id])
  userId   String? @unique
  user     User?   @relation(fields: [userId], references: [id])

  fullName    String
  cro         String
  croState    String?
  specialties String[]
  email       String?
  phone       String?
  whatsapp    String?
  color       String   @default("#1E5FBF")
  isActive    Boolean  @default(true)

  // Regra de comissão (híbrida configurável)
  commissionMode             String   @default("PERCENTAGE") // PERCENTAGE | FIXED | CUSTOM_TABLE
  commissionPercentPrivate   Decimal? @db.Decimal(5, 2)
  commissionPercentInsurance Decimal? @db.Decimal(5, 2)
  commissionFixedAmount      Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments       Appointment[]
  treatmentPlans     TreatmentPlan[]
  clinicalEvolutions ClinicalEvolution[]
  commissions        Commission[]
  commissionRules    CommissionRule[]
  toothRecords       ToothRecord[]

  @@unique([clinicId, cro, croState])
  @@index([clinicId])
  @@index([unitId])
}

model Chair {
  id          String   @id @default(cuid())
  unitId      String
  unit        Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  name        String
  code        String?
  description String?
  color       String   @default("#3DD9B0")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointments Appointment[]

  @@unique([unitId, name])
  @@index([unitId])
}

model Appointment {
  id          String     @id @default(cuid())
  clinicId    String
  clinic      Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  unitId      String
  unit        Unit       @relation(fields: [unitId], references: [id])
  patientId   String
  patient     Patient    @relation(fields: [patientId], references: [id])
  dentistId   String
  dentist     Dentist    @relation(fields: [dentistId], references: [id])
  chairId     String
  chair       Chair      @relation(fields: [chairId], references: [id])
  procedureId String?
  procedure   Procedure? @relation(fields: [procedureId], references: [id])

  createdById   String?
  createdBy     User?   @relation("AppointmentCreatedBy", fields: [createdById], references: [id])
  dentistUserId String?
  dentistUser   User?   @relation("AppointmentDentistUser", fields: [dentistUserId], references: [id])

  title             String?
  notes             String?
  startAt           DateTime
  endAt             DateTime
  status            String    @default("SCHEDULED") // SCHEDULED | CONFIRMED | IN_PROGRESS | COMPLETED | CANCELED | NO_SHOW
  confirmationToken String?   @unique
  confirmedAt       DateTime?
  reminderSentAt    DateTime?
  reminderChannel   String? // WHATSAPP | EMAIL | BOTH
  noShow            Boolean   @default(false)
  cancelReason      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  clinicalEvolutions ClinicalEvolution[]
  inventoryMovements InventoryMovement[]
  commissions        Commission[]
  transactions       Transaction[]
  notifications      Notification[]

  @@index([clinicId, startAt])
  @@index([unitId, startAt])
  @@index([dentistId, startAt])
  @@index([chairId, startAt])
  @@index([patientId])
  @@index([status])
  @@index([clinicId])
  @@index([unitId])
  @@index([dentistId])
  @@index([chairId])
  @@index([procedureId])
  @@index([createdById])
  @@index([dentistUserId])
}

model Procedure {
  id              String   @id @default(cuid())
  clinicId        String
  clinic          Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  code            String
  tissCode        String?
  name            String
  description     String?
  category        String?
  defaultPrice    Decimal  @db.Decimal(10, 2)
  durationMinutes Int      @default(30)
  requiresTooth   Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  appointments        Appointment[]
  treatmentPlanStages TreatmentPlanStage[]
  insurancePrices     InsurancePriceTable[]
  inventoryBom        ProcedureBom[]
  inventoryMovements  InventoryMovement[]
  commissions         Commission[]
  commissionRules     CommissionRule[]
  insuranceGuides     InsuranceGuide[]

  @@unique([clinicId, code])
  @@index([clinicId])
}

model Insurance {
  id                     String   @id @default(cuid())
  clinicId               String
  clinic                 Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name                   String
  ansCode                String?
  cnpj                   String?
  contactName            String?
  contactEmail           String?
  contactPhone           String?
  paymentTermDays        Int      @default(30)
  defaultDiscountPercent Decimal? @db.Decimal(5, 2)
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  priceTables     InsurancePriceTable[]
  guides          InsuranceGuide[]
  treatmentPlans  TreatmentPlan[]
  transactions    Transaction[]
  commissionRules CommissionRule[]

  @@unique([clinicId, name])
  @@index([clinicId])
}

model InsurancePriceTable {
  id                  String    @id @default(cuid())
  insuranceId         String
  insurance           Insurance @relation(fields: [insuranceId], references: [id], onDelete: Cascade)
  procedureId         String
  procedure           Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  price               Decimal   @db.Decimal(10, 2)
  reimbursementAmount Decimal?  @db.Decimal(10, 2)
  copayPercent        Decimal?  @db.Decimal(5, 2)
  validFrom           DateTime  @default(now())
  validUntil          DateTime?
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([insuranceId, procedureId, validFrom])
  @@index([insuranceId])
  @@index([procedureId])
}

model InsuranceGuide {
  id          String     @id @default(cuid())
  clinicId    String
  clinic      Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  unitId      String?
  unit        Unit?      @relation(fields: [unitId], references: [id])
  insuranceId String
  insurance   Insurance  @relation(fields: [insuranceId], references: [id])
  patientId   String
  patient     Patient    @relation(fields: [patientId], references: [id])
  procedureId String?
  procedure   Procedure? @relation(fields: [procedureId], references: [id])
  createdById String?
  createdBy   User?      @relation(fields: [createdById], references: [id])

  guideNumber       String
  authorizationCode String?
  status            String     @default("DRAFT") // DRAFT | SUBMITTED | AUTHORIZED | DENIED | BILLED | PAID
  amountClaimed     Decimal?   @db.Decimal(10, 2)
  amountApproved    Decimal?   @db.Decimal(10, 2)
  submittedAt       DateTime?
  authorizedAt      DateTime?
  paidAt            DateTime?
  notes             String?
  tissPayload       Json?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  shipments         Shipment[]

  @@unique([clinicId, guideNumber])
  @@index([clinicId])
  @@index([insuranceId])
  @@index([patientId])
  @@index([status])
  @@index([unitId])
  @@index([procedureId])
  @@index([createdById])
}

model TreatmentPlan {
  id          String     @id @default(cuid())
  clinicId    String
  clinic      Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  unitId      String?
  unit        Unit?      @relation(fields: [unitId], references: [id])
  patientId   String
  patient     Patient    @relation(fields: [patientId], references: [id])
  dentistId   String
  dentist     Dentist    @relation(fields: [dentistId], references: [id])
  insuranceId String?
  insurance   Insurance? @relation(fields: [insuranceId], references: [id])
  createdById String?
  createdBy   User?      @relation("TreatmentPlanCreatedBy", fields: [createdById], references: [id])

  title                String
  description          String?
  status               String    @default("DRAFT") // DRAFT | SENT | PARTIALLY_APPROVED | APPROVED | REJECTED | CANCELED | COMPLETED
  totalAmount          Decimal   @default(0) @db.Decimal(12, 2)
  approvedAmount       Decimal   @default(0) @db.Decimal(12, 2)
  publicToken          String    @unique
  publicTokenExpiresAt DateTime?
  sentAt               DateTime?
  approvedAt           DateTime?
  rejectedAt           DateTime?
  validUntil           DateTime?
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  stages        TreatmentPlanStage[]
  signatures    TreatmentPlanSignature[]
  transactions  Transaction[]
  notifications Notification[]

  @@index([clinicId])
  @@index([patientId])
  @@index([dentistId])
  @@index([status])
  @@index([unitId])
  @@index([insuranceId])
  @@index([createdById])
}

model TreatmentPlanStage {
  id              String        @id @default(cuid())
  treatmentPlanId String
  treatmentPlan   TreatmentPlan @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)
  procedureId     String?
  procedure       Procedure?    @relation(fields: [procedureId], references: [id])

  order           Int       @default(0)
  title           String
  description     String?
  toothNumber     Int?
  faces           String[]
  quantity        Int       @default(1)
  unitPrice       Decimal   @db.Decimal(10, 2)
  discountPercent Decimal?  @db.Decimal(5, 2)
  totalPrice      Decimal   @db.Decimal(12, 2)
  status          String    @default("PENDING") // PENDING | APPROVED | REJECTED | IN_PROGRESS | COMPLETED
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  signatures TreatmentPlanSignature[]

  @@index([treatmentPlanId])
  @@index([status])
  @@index([procedureId])
}

model TreatmentPlanSignature {
  id              String              @id @default(cuid())
  treatmentPlanId String
  treatmentPlan   TreatmentPlan       @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)
  stageId         String?
  stage           TreatmentPlanStage? @relation(fields: [stageId], references: [id])

  signerName        String
  signerCpf         String?
  signerEmail       String?
  signedAt          DateTime @default(now())
  ipAddress         String
  userAgent         String?
  hashSha256        String
  signatureImageUrl String?
  documentUrl       String?
  documentHash      String?
  method            String   @default("WEB") // WEB | APP | PRESENCIAL
  isValid           Boolean  @default(true)
  createdAt         DateTime @default(now())

  @@index([treatmentPlanId])
  @@index([stageId])
  @@index([hashSha256])
}

model ToothRecord {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  dentistId String?
  dentist   Dentist? @relation(fields: [dentistId], references: [id])

  toothNumber Int // 11-18, 21-28, 31-38, 41-48
  face        String // O | M | D | V | L | INCISAL | CERVICAL | ROOT
  status      String   @default("HEALTHY") // HEALTHY | TREATED | EXTRACTED | IN_TREATMENT | MISSING
  condition   String?
  notes       String?
  procedureId String?
  recordedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([patientId, toothNumber, face])
  @@index([patientId])
  @@index([toothNumber])
  @@index([status])
  @@index([dentistId])
}

model ClinicalEvolution {
  id            String       @id @default(cuid())
  clinicId      String
  clinic        Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId     String
  patient       Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  dentistId     String
  dentist       Dentist      @relation(fields: [dentistId], references: [id])
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  authorId      String?
  author        User?        @relation(fields: [authorId], references: [id])

  sessionDate        DateTime @default(now())
  chiefComplaint     String?
  diagnosis          String?
  treatmentPerformed String?
  prescription       String?
  observations       String?
  toothNumbers       Int[]
  isLocked           Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  attachments Attachment[]

  @@index([clinicId])
  @@index([patientId])
  @@index([dentistId])
  @@index([appointmentId])
  @@index([authorId])
}

model Attachment {
  id                  String             @id @default(cuid())
  clinicId            String
  clinic              Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId           String
  patient             Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  clinicalEvolutionId String?
  clinicalEvolution   ClinicalEvolution? @relation(fields: [clinicalEvolutionId], references: [id])
  uploadedById        String?
  uploadedBy          User?              @relation(fields: [uploadedById], references: [id])

  kind            String   @default("OTHER") // XRAY | PHOTO | DOCUMENT | OTHER
  title           String?
  description     String?
  fileName        String
  mimeType        String
  sizeBytes       Int
  storageKey      String
  storageProvider String   @default("S3") // S3 | R2 | MINIO
  url             String?
  checksum        String?
  createdAt       DateTime @default(now())

  @@index([clinicId])
  @@index([patientId])
  @@index([clinicalEvolutionId])
  @@index([uploadedById])
}

model InventoryItem {
  id       String @id @default(cuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  unitId   String
  unit     Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  sku             String
  name            String
  description     String?
  category        String?
  unitOfMeasure   String   @default("UN")
  currentQuantity Decimal  @default(0) @db.Decimal(12, 3)
  minimumQuantity Decimal  @default(0) @db.Decimal(12, 3)
  costPrice       Decimal? @db.Decimal(10, 2)
  supplierName    String?
  supplierContact String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  movements  InventoryMovement[]
  bomEntries ProcedureBom[]

  @@unique([unitId, sku])
  @@index([clinicId])
  @@index([unitId])
}

model InventoryMovement {
  id            String        @id @default(cuid())
  clinicId      String
  clinic        Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  unitId        String
  unit          Unit          @relation(fields: [unitId], references: [id])
  itemId        String
  item          InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id])
  procedureId   String?
  procedure     Procedure?    @relation(fields: [procedureId], references: [id])
  createdById   String?
  createdBy     User?         @relation(fields: [createdById], references: [id])

  type       String // IN | OUT | ADJUSTMENT | LOSS
  quantity   Decimal  @db.Decimal(12, 3)
  unitCost   Decimal? @db.Decimal(10, 2)
  totalCost  Decimal? @db.Decimal(12, 2)
  reason     String?
  reference  String?
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([clinicId])
  @@index([unitId])
  @@index([itemId])
  @@index([appointmentId])
  @@index([procedureId])
  @@index([createdById])
}

model ProcedureBom {
  id          String        @id @default(cuid())
  procedureId String
  procedure   Procedure     @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  itemId      String
  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity    Decimal       @db.Decimal(12, 3)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([procedureId, itemId])
  @@index([procedureId])
  @@index([itemId])
}

model CommissionRule {
  id          String     @id @default(cuid())
  dentistId   String
  dentist     Dentist    @relation(fields: [dentistId], references: [id], onDelete: Cascade)
  procedureId String?
  procedure   Procedure? @relation(fields: [procedureId], references: [id])
  insuranceId String?
  insurance   Insurance? @relation(fields: [insuranceId], references: [id])

  mode             String // PERCENTAGE | FIXED
  percentPrivate   Decimal? @db.Decimal(5, 2)
  percentInsurance Decimal? @db.Decimal(5, 2)
  fixedAmount      Decimal? @db.Decimal(10, 2)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([dentistId])
  @@index([procedureId])
  @@index([insuranceId])
}

model Commission {
  id            String       @id @default(cuid())
  clinicId      String
  clinic        Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  unitId        String?
  unit          Unit?        @relation(fields: [unitId], references: [id])
  dentistId     String
  dentist       Dentist      @relation(fields: [dentistId], references: [id])
  dentistUserId String?
  dentistUser   User?        @relation("CommissionDentistUser", fields: [dentistUserId], references: [id])
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  procedureId   String?
  procedure     Procedure?   @relation(fields: [procedureId], references: [id])
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  baseAmount     Decimal   @db.Decimal(12, 2)
  mode           String // PERCENTAGE | FIXED | CUSTOM_TABLE
  percentApplied Decimal?  @db.Decimal(5, 2)
  amount         Decimal   @db.Decimal(12, 2)
  status         String    @default("PENDING") // PENDING | APPROVED | PAID | CANCELED
  referenceMonth String?
  paidAt         DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([clinicId])
  @@index([dentistId])
  @@index([status])
  @@index([referenceMonth])
  @@index([unitId])
  @@index([dentistUserId])
  @@index([appointmentId])
  @@index([procedureId])
  @@index([transactionId])
}

model Transaction {
  id              String         @id @default(cuid())
  clinicId        String
  clinic          Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  unitId          String?
  unit            Unit?          @relation(fields: [unitId], references: [id])
  patientId       String?
  patient         Patient?       @relation(fields: [patientId], references: [id])
  insuranceId     String?
  insurance       Insurance?     @relation(fields: [insuranceId], references: [id])
  appointmentId   String?
  appointment     Appointment?   @relation(fields: [appointmentId], references: [id])
  treatmentPlanId String?
  treatmentPlan   TreatmentPlan? @relation(fields: [treatmentPlanId], references: [id])
  createdById     String?
  createdBy       User?          @relation(fields: [createdById], references: [id])

  type              String // RECEIVABLE | PAYABLE
  category          String?
  description       String
  amount            Decimal   @db.Decimal(12, 2)
  paidAmount        Decimal   @default(0) @db.Decimal(12, 2)
  dueDate           DateTime
  paidAt            DateTime?
  status            String    @default("PENDING") // PENDING | PAID | OVERDUE | CANCELED | PARTIAL
  paymentMethod     String? // CASH | PIX | CARD | BOLETO | INSURANCE | TRANSFER
  installmentNumber Int?
  installmentTotal  Int?
  reference         String?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  commissions Commission[]

  @@index([clinicId])
  @@index([unitId])
  @@index([type, status])
  @@index([dueDate])
  @@index([patientId])
  @@index([insuranceId])
  @@index([appointmentId])
  @@index([treatmentPlanId])
  @@index([createdById])
}

model Notification {
  id              String         @id @default(cuid())
  clinicId        String?
  clinic          Clinic?        @relation(fields: [clinicId], references: [id])
  userId          String?
  user            User?          @relation(fields: [userId], references: [id])
  patientId       String?
  patient         Patient?       @relation(fields: [patientId], references: [id])
  appointmentId   String?
  appointment     Appointment?   @relation(fields: [appointmentId], references: [id])
  treatmentPlanId String?
  treatmentPlan   TreatmentPlan? @relation(fields: [treatmentPlanId], references: [id])

  channel      String // WHATSAPP | EMAIL | SMS | PUSH | IN_APP
  provider     String? // EVOLUTION_API | ZAPI | RESEND | SENDGRID
  template     String?
  recipient    String
  subject      String?
  body         String?
  status       String    @default("PENDING") // PENDING | SENT | DELIVERED | READ | FAILED
  errorMessage String?
  externalId   String?
  payload      Json?
  scheduledFor DateTime?
  sentAt       DateTime?
  deliveredAt  DateTime?
  readAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([clinicId])
  @@index([userId])
  @@index([patientId])
  @@index([status])
  @@index([channel])
  @@index([scheduledFor])
  @@index([appointmentId])
  @@index([treatmentPlanId])
}

model AuditLog {
  id       String  @id @default(cuid())
  clinicId String?
  clinic   Clinic? @relation(fields: [clinicId], references: [id])
  userId   String?
  user     User?   @relation(fields: [userId], references: [id])

  action      String // CREATE | UPDATE | DELETE | VIEW | LOGIN | EXPORT | SIGN
  entity      String
  entityId    String?
  severity    String   @default("INFO") // INFO | WARN | CRITICAL
  description String?
  before      Json?
  after       Json?
  diff        Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([clinicId])
  @@index([userId])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
}

model Plan {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  description  String?
  priceMonthly Decimal  @db.Decimal(10, 2)
  priceYearly  Decimal? @db.Decimal(10, 2)
  currency     String   @default("BRL")
  maxUnits     Int      @default(1)
  maxUsers     Int      @default(5)
  maxDentists  Int      @default(3)
  features     Json?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id       String  @id @default(cuid())
  clinicId String
  clinic   Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  planId   String
  plan     Plan    @relation(fields: [planId], references: [id])
  userId   String?
  user     User?   @relation(fields: [userId], references: [id])

  status                 String    @default("TRIALING") // TRIALING | ACTIVE | PAST_DUE | CANCELED | PAUSED | EXPIRED
  provider               String    @default("STRIPE") // STRIPE | MERCADOPAGO | MANUAL
  providerCustomerId     String?
  providerSubscriptionId String?   @unique
  providerPriceId        String?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  trialEndsAt            DateTime?
  canceledAt             DateTime?
  cancelAtPeriodEnd      Boolean   @default(false)
  pausedAt               DateTime?
  resumedAt              DateTime?
  canceledReason         String?
  metadata               Json?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  pauseRecords PauseRecord[]
  payments     Payment[]

  @@index([clinicId])
  @@index([status])
  @@index([planId])
  @@index([userId])
}

model PauseRecord {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  pausedAt       DateTime     @default(now())
  resumedAt      DateTime?
  reason         String?
  requestedById  String?
  createdAt      DateTime     @default(now())

  @@index([subscriptionId])
}

model Payment {
  id                String       @id @default(cuid())
  subscriptionId    String
  subscription      Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  provider          String       @default("STRIPE") // STRIPE | MERCADOPAGO | MANUAL
  providerPaymentId String?      @unique
  providerInvoiceId String?
  amount            Decimal      @db.Decimal(10, 2)
  currency          String       @default("BRL")
  status            String       @default("PENDING") // PENDING | PAID | FAILED | REFUNDED | CANCELED
  method            String? // CARD | PIX | BOLETO
  paidAt            DateTime?
  failedAt          DateTime?
  failureReason     String?
  receiptUrl        String?
  periodStart       DateTime?
  periodEnd         DateTime?
  rawPayload        Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([subscriptionId])
  @@index([status])
}

model Address {
  id        String   @id @default(cuid())
  clinicId  String?
  clinic    Clinic?  @relation(fields: [clinicId], references: [id])
  unitId    String?
  unit      Unit?    @relation(fields: [unitId], references: [id])
  patientId String?
  patient   Patient? @relation(fields: [patientId], references: [id])

  label      String?
  street     String
  number     String?
  complement String?
  district   String?
  city       String
  state      String
  zipCode    String
  country    String   @default("BR")
  latitude   Float?
  longitude  Float?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([clinicId])
  @@index([unitId])
  @@index([patientId])
}

model Shipment {
  id               String          @id @default(cuid())
  clinicId         String
  clinic           Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  fromUnitId       String?
  fromUnit         Unit?           @relation("ShipmentFromUnit", fields: [fromUnitId], references: [id])
  toUnitId         String?
  toUnit           Unit?           @relation("ShipmentToUnit", fields: [toUnitId], references: [id])
  patientId        String?
  patient          Patient?        @relation(fields: [patientId], references: [id])
  insuranceGuideId String?
  insuranceGuide   InsuranceGuide? @relation(fields: [insuranceGuideId], references: [id])

  trackingCode String?
  carrier      String?
  kind         String    @default("DOCUMENT") // DOCUMENT | MATERIAL | XRAY | OTHER
  status       String    @default("PENDING") // PENDING | IN_TRANSIT | DELIVERED | RETURNED | LOST
  description  String?
  shippedAt    DateTime?
  deliveredAt  DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([clinicId])
  @@index([status])
  @@index([trackingCode])
  @@index([fromUnitId])
  @@index([toUnitId])
  @@index([patientId])
  @@index([insuranceGuideId])
}
